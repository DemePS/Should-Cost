# Copy to .env for local development. Names only — never commit real values.
# In Azure, these are App Service application settings injected by the CD pipeline
# from Azure DevOps variable groups (see docs/deployment.md). There is no Key Vault.

# ── SharePoint / Microsoft Graph ──────────────────────────────────────────────
# Root folder: "15_Should Cost Analyses" — URL or site-relative path.
SHAREPOINT_SITE_URL=
SHAREPOINT_ROOT_FOLDER=
SHAREPOINT_OUTPUT_FOLDER=

# managed_identity (default in Azure) or client_secret (local dev only)
GRAPH_CREDENTIAL=managed_identity
# Only used when GRAPH_CREDENTIAL=client_secret
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Model provider ────────────────────────────────────────────────────────────
# foundry (default), anthropic, or deepseek. Drives the 3 structured model calls +
# the research agent. MODEL_DEPLOYMENT is the model/deployment name on whichever
# provider is selected below (e.g. "gpt-4o" for foundry, "claude-sonnet-5-5" for
# anthropic, "deepseek-chat" for deepseek).
MODEL_PROVIDER=foundry
MODEL_DEPLOYMENT=

# Azure AI Foundry — only used when MODEL_PROVIDER=foundry.
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
# default (DefaultAzureCredential — managed identity in Azure, role "Cognitive Services
# User"; your "az login" session on localhost, no extra config needed) or api_key (fallback)
AZURE_AI_FOUNDRY_CREDENTIAL=default
# Only used when AZURE_AI_FOUNDRY_CREDENTIAL=api_key
AZURE_AI_FOUNDRY_API_KEY=

# Anthropic — only used when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# DeepSeek — only used when MODEL_PROVIDER=deepseek. OpenAI-compatible API, so no
# dedicated connector is needed, just this base URL.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Research agent web search ──────────────────────────────────────────────────
# hosted (Bing grounding on foundry; each provider's own native hosted search tool on
# anthropic/deepseek — deepseek's is only documented for MODEL_DEPLOYMENT=deepseek-flash)
# or tavily (fallback function tool, works with every provider)
SEARCH_PROVIDER=hosted
TAVILY_API_KEY=

# ── State store ────────────────────────────────────────────────────────────────
# azure_table or azure_blob
STATE_BACKEND=azure_table
# Storage account access via managed identity — no connection string.
STATE_STORAGE_ACCOUNT_NAME=
JOB_RETENTION_DAYS=90

# LangGraph's own checkpoint file (interrupt/resume for the workflow graph) — a local
# sqlite file, separate from the Job snapshot above which STATE_BACKEND governs.
LANGGRAPH_CHECKPOINT_DB_PATH=/tmp/should_cost_langgraph_checkpoints.sqlite

# ── Auth (v1 stub — see docs/auth-later.md) ───────────────────────────────────
AUTH_ENABLED=false

# ── Application Insights ───────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Runtime ─────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
