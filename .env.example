# Copy to .env for local development. Names only — never commit real values.
# In Azure, these are App Service application settings injected by the CD pipeline
# from Azure DevOps variable groups (see docs/deployment.md). There is no Key Vault.

# ── SharePoint / Microsoft Graph ──────────────────────────────────────────────
# Root folder: "15_Should Cost Analyses" — URL or site-relative path.
SHAREPOINT_SITE_URL=
SHAREPOINT_ROOT_FOLDER=
SHAREPOINT_OUTPUT_FOLDER=

# managed_identity (default in Azure) or client_secret (local dev only)
GRAPH_CREDENTIAL=managed_identity
# Only used when GRAPH_CREDENTIAL=client_secret
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Azure AI Foundry ───────────────────────────────────────────────────────────
AZURE_AI_FOUNDRY_ENDPOINT=
MODEL_DEPLOYMENT=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
# managed_identity (default, role "Cognitive Services User") or api_key (fallback)
AZURE_AI_FOUNDRY_CREDENTIAL=managed_identity
# Only used when AZURE_AI_FOUNDRY_CREDENTIAL=api_key
AZURE_AI_FOUNDRY_API_KEY=

# ── Research agent web search ──────────────────────────────────────────────────
# hosted (Bing grounding via Microsoft Agent Framework) or tavily (fallback function tool)
SEARCH_PROVIDER=hosted
TAVILY_API_KEY=

# ── State store ────────────────────────────────────────────────────────────────
# azure_table or azure_blob
STATE_BACKEND=azure_table
# Storage account access via managed identity — no connection string.
STATE_STORAGE_ACCOUNT_NAME=
JOB_RETENTION_DAYS=90

# ── Auth (v1 stub — see docs/auth-later.md) ───────────────────────────────────
AUTH_ENABLED=false

# ── Application Insights ───────────────────────────────────────────────────────
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ── Runtime ─────────────────────────────────────────────────────────────────────
PORT=8000
LOG_LEVEL=INFO
